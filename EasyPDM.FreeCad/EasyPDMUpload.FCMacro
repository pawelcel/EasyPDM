        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def comment_text(self):
        return self.comment_edit.toPlainText().strip()


class WaitForTicketDialog(QtWidgets.QDialog):
    """Pokazywane PO otwarciu przeglądarki na formularzu dodawania (zob.
    build_browser_create_url/_submit_new) — odpytuje GET /api/create-tickets/{ticket} co
    POLL_INTERVAL_MS, aż użytkownik zapisze element w przeglądarce, aż upłynie timeout, albo
    aż sam kliknie Anuluj. accept()/reject() są nadpisane, żeby timer ZAWSZE zatrzymywał się
    razem z zamknięciem okna — niezależnie od tego, którą drogą się ono zamyka (przycisk,
    Escape, systemowy krzyżyk) — inaczej odpaliłby się jeszcze raz w już zniszczony dialog."""

    POLL_INTERVAL_MS = 2000

    def __init__(self, ticket, parent=None, timeout_seconds=600):
        super().__init__(parent)
        self.ticket = ticket
        self.result_data = None
        self._elapsed_ms = 0
        self._timeout_ms = timeout_seconds * 1000

        self.setWindowTitle(t("wait_ticket_title"))
        self.setMinimumWidth(380)

        layout = QtWidgets.QVBoxLayout(self)
        label = QtWidgets.QLabel(t("wait_ticket_body"))
        label.setWordWrap(True)
        layout.addWidget(label)

        self.error_label = QtWidgets.QLabel("")
        self.error_label.setStyleSheet("color: #c0392b;")
        self.error_label.setWordWrap(True)
        layout.addWidget(self.error_label)

        buttons = QtWidgets.QDialogButtonBox(QtWidgets.QDialogButtonBox.Cancel)
        buttons.button(QtWidgets.QDialogButtonBox.Cancel).setText(t("cancel_button"))
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

        self._timer = QtCore.QTimer(self)
        self._timer.setInterval(self.POLL_INTERVAL_MS)
        self._timer.timeout.connect(self._poll)
        self._timer.start()

    def accept(self):
        self._timer.stop()
        super().accept()

    def reject(self):
        self._timer.stop()
        super().reject()

    def _poll(self):
        self._elapsed_ms += self.POLL_INTERVAL_MS
        if self._elapsed_ms >= self._timeout_ms:
            self.error_label.setText(t("wait_timeout"))
            self.reject()
            return
        try:
            data = api_get(f"/create-tickets/{self.ticket}")
        except Exception as e:
            # Chwilowy błąd sieci nie przerywa czekania — kolejny cykl spróbuje ponownie.
            self.error_label.setText(str(e))
            return
        if data and data.get("itemId"):
            self.result_data = data
            self.accept()


def submit_via_browser(doc, target_folder):
    """Droga tworzenia nowego elementu ALBO dogrywania do istniejącego, gdy nie ma
    wystarczająco pewnego lokalnego dopasowania (zob. blok "already_linked" poniżej dla
    przypadku, gdy jest) — obie decyzje ("co", i "który") zapadają w przeglądarce, nie
    lokalnie (zob. build_browser_create_url). Makro: generuje bilet, otwiera przeglądarkę,
    czeka (WaitForTicketDialog). Po stronie przeglądarki dwie możliwe drogi dopełniają ten
    sam bilet: zwykłe "Dodaj" (nowy element, POST /nodes z ticketem) albo baner "oczekujące
    żądanie z makra" -> dogranie do istniejącego (POST /create-tickets/{ticket}/attach-
    existing) — GET /create-tickets/{ticket} zwraca pole "existing", które mówi, którą z
    dwóch dalszych ścieżek odpalić: dla nowego elementu wprost _rename_and_upload
    (rewizja=1); dla dogrania do istniejącego push_to_existing_item — ten ma WŁASNĄ,
    lokalną obsługę statusu "wydany" (pyta o nową rewizję i opcjonalny komentarz przez
    NewRevisionDialog) — to jedyna decyzja, która świadomie ZOSTAJE lokalna, bo jest
    bezpośrednio związana z tym, co makro zaraz zrobi z plikiem na dysku, a nie z
    właściwościami elementu w PDM.

    Czy eksportować STEP i/lub PDF wybiera się WYŁĄCZNIE w przeglądarce, jako dwa
    NIEZALEŻNE checkboxy widoczne w obu ścieżkach — makro nie ma tu żadnego lokalnego
    wyboru/fallbacku poza domyślnymi wartościami (STEP "tak", PDF "nie"), gdyby formularz
    z jakiegoś powodu nie przekazał wartości (starsza wersja frontendu).

    Zwraca to samo co _rename_and_upload/push_to_existing_item, albo None jeśli
    anulowano/upłynął czas oczekiwania — ten sam sygnał "nic nie zostało wysłane", który
    run() już rozumie."""
    try:
        existing_items = api_get("/items") or []
    except Exception:
        existing_items = []
    matched = match_existing_item(doc, existing_items)

    # Etykieta dokumentu wygląda jak "numer (nazwa).REWIZJA" i taki numer+nazwa istnieją w
    # PDM (zob. match_existing_item) -- pytamy WPROST, natywnie, czy podpiąć bieżącą wersję
    # jako nową rewizję TEGO elementu, zamiast po cichu zakładać "nowy" i zmuszać do ręcznego
    # znalezienia go przez wyszukiwarkę w przeglądarce (potwierdzone w praktyce: domyślny
    # wybór w przeglądarce to "Nowy element", więc bez tego pytania łatwo przeoczyć, że
    # dokument już istnieje, i utworzyć duplikat). Ten sam pomysł co natywna ścieżka
    # "already linked" w EasyPDMUpload.bas (SolidWorks), tam oparta o Custom Property
    # (pewny link) -- tutaj o dopasowanie etykiety (mniej pewne, stąd "Nie" tu NIE anuluje
    # całości, tylko spada do zwykłego formularza w przeglądarce poniżej, gdzie to samo
    # dopasowanie i tak zostaje podpowiedziane w wyszukiwarce "Dogranie do istniejącego").
    if matched:
        confirm = QtWidgets.QMessageBox.question(
            None,
            t("pdm_title"),
            t("already_linked_confirm", number=matched.get("itemNumber"), name=matched.get("fileName")),
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
            QtWidgets.QMessageBox.Yes,
        )
        if confirm == QtWidgets.QMessageBox.Yes:
            native_export_step = QtWidgets.QMessageBox.question(
                None, t("pdm_title"), t("export_step_prompt"),
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                QtWidgets.QMessageBox.Yes,
            ) == QtWidgets.QMessageBox.Yes
            native_export_pdf = QtWidgets.QMessageBox.question(
                None, t("pdm_title"), t("export_pdf_prompt"),
                QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
                QtWidgets.QMessageBox.No,
            ) == QtWidgets.QMessageBox.Yes

            def confirm_new_revision():
                dlg = NewRevisionDialog()
                if dlg.exec() != QtWidgets.QDialog.Accepted:
                    return None
                return dlg.comment_text()

            return push_to_existing_item(
                doc, matched["id"], confirm_new_revision,
                target_folder=target_folder, export_step=native_export_step, export_pdf=native_export_pdf,
            )
        # "Nie" -- spada do zwykłego formularza w przeglądarce poniżej, z tym samym
        # dopasowaniem nadal podpowiedzianym tam (suggested_item_number), na wypadek gdyby
        # user jednak chciał wybrać "Dogranie do istniejącego" ręcznie.

    suggested_item_number = matched["itemNumber"] if matched else None

    ticket = str(uuid.uuid4())
    url = build_browser_create_url(doc.Label, ticket, suggested_item_number)
    try:
        webbrowser.open(url)
    except Exception as e:
        QtWidgets.QMessageBox.critical(None, t("pdm_title"), t("open_browser_failed", error=e))
        return None

    wait_dlg = WaitForTicketDialog(ticket)
    if wait_dlg.exec() != QtWidgets.QDialog.Accepted:
        return None

    ticket_data = wait_dlg.result_data
    export_step = ticket_data.get("exportStep")
    if export_step is None:
        export_step = True
    export_pdf = ticket_data.get("exportPdf")
    if export_pdf is None:
        export_pdf = False

    if ticket_data.get("existing"):
        def confirm_new_revision():
            dlg = NewRevisionDialog()
            if dlg.exec() != QtWidgets.QDialog.Accepted:
                return None
            return dlg.comment_text()

        return push_to_existing_item(
            doc, ticket_data["itemId"], confirm_new_revision,
            target_folder=target_folder, export_step=export_step, export_pdf=export_pdf,
        )

    return _rename_and_upload(
        doc, ticket_data["itemId"], ticket_data["itemNumber"], ticket_data["name"],
        1, target_folder, export_step, export_pdf,
    )


def process_assembly_tree(top_doc, target_folder=None):
    """Wykrywa złożenie (App::Link do zewnętrznych plików, rekurencyjnie) i dla KAŻDEGO
    nowego komponentu (jeszcze nie wysłanego do PDM — rozpoznawane po etykiecie
    "numer (nazwa).REWIZJA", zob. match_existing_item) przechodzi przez TEN SAM bilet
    przeglądarki co główny dokument (zob. submit_via_browser) — jedna karta na raz, po
    kolei, w tej samej kolejności "liście najpierw" co reszta tego drzewa (nigdy kilka kart
    naraz — myląco się w tym gubić, a ochrona Windows przed "kradzieżą focusu" i tak
    wyciszyłaby każdą kolejną kartę otwartą zaraz po poprzedniej bez świeżej interakcji
    użytkownika, patrz notatka przed każdym otwarciem karty). Po utworzeniu/dograniu
    podpina relacje rodzic-dziecko (BOM) MIĘDZY odkrytymi komponentami.
    Relacje, gdzie rodzicem jest top_doc, NIE są tu podpinane — top_doc jeszcze nie ma
    swojego item_id w PDM (może to być nowy ALBO już istniejący element — o tym decyduje
    reszta run(), przez submit_via_browser); te relacje dopina run() po jego utworzeniu.

    Zwraca (edges_for_top, cancelled, locked_matches):
        edges_for_top   — lista (child_item_id, quantity, newly_created) do podpięcia pod
                          element top_doc (newly_created mówi run(), czy po podpięciu
                          trzeba ukryć ten element z korzenia projektu, zob. niżej),
        cancelled       — True, jeśli użytkownik przerwał w trakcie. Komponenty utworzone
                          PRZED przerwaniem zostają w PDM (tak samo jak reszta makra nie
                          cofa częściowo wykonanych kroków w razie błędu w połowie),
        locked_matches  — lista (itemNumber, fileName, status) dla już-podlinkowanych
                          komponentów (dopasowanych po etykiecie, patrz niżej) których
                          status to "sprawdzany"/"wydany" — takie komponenty są WYŁĄCZNIE
                          referencjonowane, nigdy nie próbujemy ich ponownie wysłać
                          niezależnie od statusu (drzewo złożenia w ogóle nie aktualizuje
                          już-istniejących komponentów, tylko podpina nowe) — ale run()
                          pokazuje tę listę w podsumowaniu na końcu, żeby było wiadomo,
                          które ewentualnie zmienione lokalnie części NIE zostały wysłane."""
    order, docs, edges = discover_component_tree(top_doc)
    if not order:
        return [], False, []

    try:
        existing_items = api_get("/items") or []
    except Exception as e:
        QtWidgets.QMessageBox.warning(None, t("pdm_title"), t("fetch_items_failed", error=e))
        existing_items = []

    # Pokazuje DOCELOWY numer/nazwę elementu dla każdego już rozpoznanego komponentu, nie
    # samą nazwę pliku -- jedyna szansa, żeby zauważyć nieaktualne dopasowanie, zanim
    # cokolwiek zostanie ruszone. match_existing_item dopasowuje po etykiecie dokumentu
    # ("numer (nazwa).REWIZJA"), a "Save As" w FreeCAD kopiuje etykietę razem z całą
    # resztą -- zapisanie od nowa, genuinie INNEJ części z takiej kopii sprawia, że makro
    # "rozpozna" ją jako STARY element, zamiast utworzyć nowy (potwierdzone w praktyce na
    # analogicznym mechanizmie w makrze SolidWorks -- tam przez Custom Property zamiast
    # etykiety, ale ryzyko jest identyczne).
    summary_lines = []
    for f in order:
        line = f"- {os.path.basename(f)}"
        matched_for_summary = match_existing_item(docs[f], existing_items)
        if matched_for_summary:
            line += t(
                "already_in_pdm_as",
                number=matched_for_summary.get("itemNumber"),
                name=matched_for_summary.get("fileName"),
            )
        summary_lines.append(line)
    summary = "\n".join(summary_lines)

    choice = QtWidgets.QMessageBox.question(
        None,
        t("assembly_detected_title"),
        t("assembly_detected_body", count=len(order), summary=summary),
        QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No | QtWidgets.QMessageBox.Cancel,
        QtWidgets.QMessageBox.Yes,
    )
    if choice == QtWidgets.QMessageBox.Cancel:
        return [], True, []
    if choice == QtWidgets.QMessageBox.No:
        return [], False, []

    # Ścieżki UTWORZONE w tym biegu (w odróżnieniu od już-istniejących komponentów, tylko
    # podpinanych) -- gdy taki element zostanie podpięty pod swojego prawdziwego rodzica
    # poniżej, znika z korzenia projektu (show_in_tree=False). Nigdy nie był niezależnym
    # elementem -- jego utworzenie jest wyłącznie efektem ubocznym kolejności wysyłki
    # liście-najpierw (utwórz liść, POTEM podepnij go pod właściwego rodzica). Element JUŻ
    # podlinkowany to potencjalnie niezależny, celowo widoczny wpis katalogu -- podpięcie go
    # tutaj NIE może ruszać jego istniejącej widoczności na korzeniu (ta sama zasada co przy
    # ręcznym dodaniu istniejącego elementu do złożenia w aplikacji webowej).
    newly_created_paths = set()
    # Już-podlinkowane komponenty o zablokowanym statusie -- zbierane tu, pokazywane
    # dopiero w podsumowaniu na końcu run() (patrz docstring wyżej).
    locked_matches = []

    doc_to_item_id = {}
    for file_path in order:
        doc = docs[file_path]
        matched = match_existing_item(doc, existing_items)
        if matched:
            doc_to_item_id[file_path] = matched["id"]
            matched_status = matched.get("status")
            if matched_status in ("sprawdzany", "wydany"):
                locked_matches.append((matched.get("itemNumber"), matched.get("fileName"), matched_status))
        else:
            # Ten sam bilet przeglądarki co główny dokument (submit_via_browser) --
            # otwierany JEDEN NA RAZ. Natywny popup tuż przed każdym otwarciem karty:
            # ochrona Windows przed "kradzieżą focusu" przepuszcza tylko PIERWSZE
            # programowe otwarcie przeglądarki w danym biegu, każde kolejne bez świeżej
            # interakcji użytkownika ląduje bez focusu (potwierdzone w praktyce na
            # analogicznym mechanizmie w makrze SolidWorks) -- kliknięcie OK tutaj liczy
            # się jako świeża interakcja.
            suggested_name = doc.Label
            QtWidgets.QMessageBox.information(
                None, t("pdm_title"), t("new_component_browser_prompt", name=suggested_name)
            )

            ticket = str(uuid.uuid4())
            url = build_browser_create_url(suggested_name, ticket)
            try:
                webbrowser.open(url)
            except Exception as e:
                QtWidgets.QMessageBox.critical(None, t("pdm_title"), t("open_browser_failed", error=e))
                return [], True, locked_matches

            wait_dlg = WaitForTicketDialog(ticket)
            if wait_dlg.exec() != QtWidgets.QDialog.Accepted:
                return [], True, locked_matches

            ticket_data = wait_dlg.result_data
            comp_export_step = ticket_data.get("exportStep")
            if comp_export_step is None:
                comp_export_step = True
            comp_export_pdf = ticket_data.get("exportPdf")
            if comp_export_pdf is None:
                comp_export_pdf = False

            try:
                if ticket_data.get("existing"):
                    def confirm_new_revision():
                        rev_dlg = NewRevisionDialog()
                        if rev_dlg.exec() != QtWidgets.QDialog.Accepted:
                            return None
                        return rev_dlg.comment_text()

                    result = push_to_existing_item(
                        doc, ticket_data["itemId"], confirm_new_revision,
                        target_folder=target_folder, export_step=comp_export_step, export_pdf=comp_export_pdf,
                    )
                    if result is None:
                        # Albo element już istniejący jest "wydany" i użytkownik odmówił
                        # nowej rewizji, albo ma status "sprawdzany" i push_to_existing_item
                        # zablokował wysyłkę z własnym komunikatem -- w obu przypadkach
                        # traktujemy jak każdą inną rezygnację w tej pętli.
                        return [], True, locked_matches
                else:
                    # Nowy element -- już istnieje po stronie serwera (przeglądarka
                    # wywołała POST /nodes z tym biletem), więc kończymy WPROST wysyłką
                    # pliku; tworzenie kolejnego elementu przez API stworzyłoby DRUGI
                    # rekord.
                    result = _rename_and_upload(
                        doc, ticket_data["itemId"], ticket_data["itemNumber"], ticket_data["name"],
                        1, target_folder, comp_export_step, comp_export_pdf,
                    )
                    newly_created_paths.add(file_path)
            except Exception as e:
                QtWidgets.QMessageBox.critical(
                    None, t("pdm_title"), t("upload_component_failed", file=os.path.basename(file_path), error=e)
                )
                return [], True, locked_matches
            doc_to_item_id[file_path] = result["itemId"]

        # Podpinamy relacje TERAZ, w TEJ SAMEJ iteracji w której file_path (jako rodzic)
        # właśnie dostał swoje item_id — NIE w osobnej pętli po całkowitym zakończeniu
        # tworzenia wszystkich komponentów. "order" gwarantuje dzieci przed rodzicami
        # (zob. discover_component_tree), więc każde dziecko z "edges" ma tu już swoje
        # item_id. Dzięki temu przerwanie w połowie (return wyżej, przy kolejnym pliku)
        # zostawia już utworzone komponenty PRAWIDŁOWO POWIĄZANE między sobą, zamiast
        # (jak wcześniej) kompletnie osieroconymi, bez żadnej struktury BOM.
        for parent_file, child_file, qty in edges:
            if parent_file != file_path:
                continue
            child_item_id = doc_to_item_id.get(child_file)
            if child_item_id is None:
                continue
            try:
                api_post_json(
                    f"/items/{doc_to_item_id[file_path]}/children",
                    {"childId": child_item_id, "quantity": qty},
                )
            except Exception as e:
                QtWidgets.QMessageBox.warning(
                    None,
                    t("pdm_title"),
                    t(
                        "link_child_failed",
                        child=os.path.basename(child_file),
                        parent=os.path.basename(parent_file),
                        error=e,
                    ),
                )
                continue

            if child_file in newly_created_paths:
                # Teraz prawidłowo zagnieżdżony pod swoim prawdziwym rodzicem -- ukryj go
                # z korzenia projektu (zob. komentarz przy newly_created_paths wyżej).
                try:
                    api_patch_json(f"/items/{child_item_id}/visibility", {"showInTree": False})
                except Exception:
                    pass

    # Relacje, w których rodzicem jest top_doc SAMO W SOBIE, nie mogły zostać podpięte
    # w pętli powyżej (top_doc celowo nie jest częścią "order" — nie ma jeszcze własnego
    # item_id, o tym decyduje reszta run()) — zwracamy je do podpięcia przez wywołującego.
    edges_for_top = [
        (doc_to_item_id[child_file], qty, child_file in newly_created_paths)
        for parent_file, child_file, qty in edges
        if parent_file == top_doc.FileName and child_file in doc_to_item_id
    ]

    return edges_for_top, False, locked_matches


def run():
    # Krok 0: upewnij się, że jest aktywna sesja — EasyPDM.Api wymaga jej dla każdego
    # wywołania poza samym logowaniem.
    if not ensure_logged_in():
        return  # użytkownik anulował logowanie

    doc = App.ActiveDocument
    if doc is None:
        QtWidgets.QMessageBox.warning(None, t("pdm_title"), t("no_active_document"))
        return

    # Krok 1: zapisz element przed wrzuceniem do PDM.
    if not doc.FileName:
        QtWidgets.QMessageBox.information(
            None, t("pdm_title"), t("document_not_saved")
        )
        import FreeCADGui as Gui

        Gui.runCommand("Std_SaveAs")
        if not doc.FileName:
            return  # użytkownik anulował zapis
    else:
        try:
            # recompute PRZED save — bez tego (potwierdzone w praktyce: gwiazdka "niezapisane
            # zmiany" pojawiała się natychmiast po tym save, jeszcze przed oknem folderu)
            # save łapie dokument PRZED ustabilizowaniem się solvera złączeń workbencha
            # Assembly, więc plik od razu po zapisie znów wygląda na "dotknięty".
            doc.recompute()
            doc.save()
        except Exception as e:
            QtWidgets.QMessageBox.critical(None, t("pdm_title"), t("save_failed", error=e))
            return

    # Krok 1a-0: folder docelowy dla lokalnych kopii (Save As) — pytamy RAZ, na samym
    # początku, przed process_assembly_tree (które dla automatycznie wykrytego drzewa i tak
    # wysyła części WCZEŚNIEJ niż otworzy się główne okno) — dzięki temu wszystkie
    # komponenty (części + finalne złożenie) lądują w TYM SAMYM, jednym folderze.
    folder_dialog = TargetFolderDialog(doc)
    if folder_dialog.exec() != QtWidgets.QDialog.Accepted:
        return
    target_folder = folder_dialog.result_folder

    # Eksport STEP/PDF nie jest już nigdzie wyborem w samym makrze -- decydują o tym dwa
    # niezależne checkboxy w przeglądarce, ZA KAŻDYM RAZEM gdy przeglądarka pośredniczy:
    # dla głównego dokumentu (Krok 2 niżej) i, od teraz, TAKŻE dla każdego automatycznie
    # wykrytego nowego komponentu złożenia z osobna (zob. process_assembly_tree) -- każdy
    # dostaje WŁASNY bilet, więc własny wybór, nie jeden odgórny dla całego drzewa.
    #
    # Krok 1a: wykryj i (opcjonalnie) wyślij złożenie rekurencyjnie — części/pod-złożenia
    # znalezione przez App::Link, w kolejności liście-najpierw.
    edges_for_top, cancelled, locked_matches = process_assembly_tree(doc, target_folder)
    if cancelled:
        QtWidgets.QMessageBox.information(None, t("pdm_title"), t("cancelled_upload"))
        return

    # Krok 2: nowy element czy dogranie do istniejącego? Makro już o to w ogóle nie pyta —
    # ta decyzja, razem z wyborem CO/KTÓRY, zapada w przeglądarce (zob. submit_via_browser).
    info = submit_via_browser(doc, target_folder)

    if info is None:
        # Anulowano/upłynął czas oczekiwania na przeglądarkę, element był "Wydany" i
        # użytkownik odmówił stworzenia nowej rewizji, albo element ma status "Sprawdzany"
        # i push_to_existing_item już pokazał własny komunikat blokujący — w każdym z tych
        # przypadków nic nie wysłano.
        QtWidgets.QMessageBox.information(None, t("pdm_title"), t("nothing_sent"))
        return

    # Krok 3: podepnij pod TEN element podelementy odkryte w kroku 1a (BOM) — dopiero teraz
    # znamy jego item_id, niezależnie od tego, czy był nowy, czy już istniał w PDM.
    for child_item_id, qty, newly_created in edges_for_top:
        try:
            api_post_json(
                f"/items/{info['itemId']}/children", {"childId": child_item_id, "quantity": qty}
            )
        except Exception as e:
            QtWidgets.QMessageBox.warning(
                None, t("pdm_title"), t("link_subitem_failed", error=e)
            )
            continue

        if newly_created:
            # Utworzony wyłącznie jako efekt uboczny przetwarzania drzewa (zob.
            # process_assembly_tree) -- teraz prawidłowo zagnieżdżony pod TYM dokumentem,
            # ukryj go z korzenia projektu.
            try:
                api_patch_json(f"/items/{child_item_id}/visibility", {"showInTree": False})
            except Exception:
                pass

    # Mimo że doc już przeszedł przez _rename_and_upload (Label + saveAs), FreeCAD potrafi
    # oznaczyć dokument jako "dotknięty" (gwiazdka przy nazwie) PO tym zapisie — recompute
    # samego top_doc nie wystarczył w praktyce (potwierdzone przez użytkownika), więc
    # przelatujemy po WSZYSTKICH otwartych dokumentach (złożenie + wszystkie linkowane
    # Części/pod-złożenia otwarte w tej samej sesji przez process_assembly_tree) — cicho
    # ignorując błędy pojedynczego dokumentu, żeby jeden nieudany zapis nie zablokował reszty.
    for open_doc in App.listDocuments().values():
        try:
            open_doc.recompute()
            open_doc.save()
        except Exception:
            pass

    if info.get("localRenamed"):
        local_line = t("local_renamed_line", path=doc.FileName)
    else:
        local_line = t("local_already_named_line", path=doc.FileName)

    if locked_matches:
        status_labels = {"sprawdzany": t("status_label_sprawdzany"), "wydany": t("status_label_wydany")}
        lines = "\n".join(
            f"- {number} ({name}) -- {status_labels.get(status, status)}"
            for number, name, status in locked_matches
        )
        locked_tail = t("locked_components_tail", count=len(locked_matches), lines=lines)
    else:
        locked_tail = ""

    QtWidgets.QMessageBox.information(
        None,
        t("pdm_title"),
        t("upload_success_sent", number=info["itemNumber"])
        + (t("upload_success_with_subitems", count=len(edges_for_top)) if edges_for_top else "")
        + t("upload_success_tail", path=info["newPath"], local=local_line)
        + locked_tail,
    )


# Odpala się tylko, gdy faktycznie działa GUI FreeCAD (a nie np. freecadcmd/import
# do testów) — bez GUI i tak nie dałoby się pokazać okna dialogowego.
if App.GuiUp:
    run()
