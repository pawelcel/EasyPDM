# -*- coding: utf-8 -*-
"""
EasyPDMUpload — makro FreeCAD do wysyłania aktywnego dokumentu do EasyPDM.

Instalacja / uruchomienie:
    Macro -> Macros... -> "Add path to macro path list" -> wskaż ten folder,
    albo po prostu "Execute macro from file" i wybierz ten plik bezpośrednio.
    Nie wymaga instalacji jako workbench.

Co robi (w tej kolejności):
    1. Zapisuje aktywny dokument na dysku (jeśli nie był jeszcze zapisany, prosi o
       wskazanie ścieżki przez natywne okno "Zapisz jako").
    1a. Pyta o FOLDER DOCELOWY dla lokalnych kopii (Save As) wszystkich dokumentów,
        które zostaną wysłane w tej sesji (patrz punkt 3 niżej) — domyślnie podpowiada
        ostatnio użyty (WSPÓLNA preferencja z EasyPDMDownload.FCMacro, DownloadFolder),
        z możliwością zmiany. Pytane RAZ, na samym początku — obejmuje też automatycznie
        wykryte drzewo złożenia (część/pod-złożenia), wysyłane wcześniej niż otwiera się
        główne okno.
    2. Jeśli etykieta dokumentu wygląda jak "numer (nazwa).REWIZJA" i taki element
       faktycznie istnieje w PDM (zob. match_existing_item), pyta WPROST, natywnie: podpiąć
       bieżącą wersję jako nową rewizję TEGO elementu? Zgoda -> dwa kolejne natywne
       pytania Tak/Nie (STEP? PDF?) i koniec, bez przeglądarki. Odmowa (albo brak takiego
       dopasowania) -> otwiera PRZEGLĄDARKĘ SYSTEMOWĄ, już zalogowaną (most token-
       >ciasteczko, zob. "Logowanie" niżej), na pasku
       "oczekuje żądanie z makra CAD" (widoczny na każdym ekranie aplikacji webowej, dopóki
       bilet czeka). Pasek pokazuje JAWNY wybór trzema przyciskami — WYBÓR "nowy element,
       duplikat czy dogranie do istniejącego" zapada tam, nie lokalnie i nie przez
       przypadkowe kliknięcie byle "Dodaj" gdziekolwiek w aplikacji (świadomie NIE dzieje
       się w ten sposób — inaczej jakiekolwiek "Dodaj" kliknięte w międzyczasie, w
       zupełnie niezwiązanym miejscu, mogłoby przez pomyłkę "połknąć" czekający bilet):
       - **"Nowy element"** — otwiera samowystarczalny POPUP (bez potrzeby wcześniejszej
         nawigacji po panelu projektów po lewej) — dopiero W TYM POPUPIE wybiera się projekt,
         opcjonalnie element nadrzędny, typ (Część/Złożenie), wpisuje nazwę, rodzaj (dla
         Części: Wykonywana/Zakupowa/Normalia/Klienta — dla Złożenia opcjonalnie, bez
         "Klienta") i zależne od niego pola (Wykonywana: Materiał; Zakupowa: Producent/Numer
         zamówieniowy 1 i 2/Masa; Normalia: Materiał/Norma; Klienta: brak dodatkowych pól),
         a także czy eksportować i wysłać model STEP (checkbox w tym samym popupie). Bilet
         jest przypięty JAWNIE do tego jednego, konkretnego popupu — żadne INNE "Dodaj" w
         aplikacji (w drzewie projektu, panelu szczegółów) nigdy przypadkiem go nie
         "połknie". "Anuluj" w popupie wraca do wyboru "Nowy element"/"Duplikuj"/"Dograj
         do istniejącego" bez tworzenia niczego.
       - **"Duplikuj"** — najpierw wyszukiwarka wskazuje ŹRÓDŁOWY element (Część/Złożenie)
         z CAŁEJ bazy, potem otwiera TEN SAM popup co "Nowy element", tylko wstępnie
         wypełniony jego właściwościami (rodzaj/materiał/producent/numery/norma/masa) —
         BEZ kopiowania żadnego pliku. Wszystkie pola dalej można edytować przed zapisem;
         to zwykłe tworzenie nowego elementu, tylko podpowiedziane danymi ze źródła.
       - **"Dograj do istniejącego"** — rozwija wyszukiwarkę Części/Złożenia z
         CAŁEJ bazy (nie tylko bieżącego projektu, bo komponent może być współdzielony)
         razem z tym samym checkboksem STEP. Jeśli etykieta lokalnego dokumentu wygląda jak
         "numer (nazwa).REWIZJA" (bo to samo makro już go tak nazwało po wcześniejszej
         wysyłce), wyszukiwarka od razu podpowiada dopasowany element — tylko podpowiedź,
         wybór zawsze można zmienić.
       Jeden wspólny formularz/pasek w przeglądarce dla WSZYSTKIEGO, więc te reguły nie mogą
       się już rozjechać między makrem a aplikacją webową. Po zdecydowaniu w przeglądarce
       (dowolną z trzech dróg wyżej), makro (okno "Czekam na przeglądarkę", odpytujące co
       ~2s) samo wykrywa zakończenie i kontynuuje — patrz punkt 3 niżej. Anulowanie w
       przeglądarce/oknie oczekiwania albo przekroczenie 10 minut kończy makro komunikatem,
       bez tworzenia/dogrywania żadnego pliku (element mógł już powstać w PDM, jeśli
       zdążono go zapisać w przeglądarce — tylko plik CAD nie zostanie do niego dograny;
       wtedy trzeba uruchomić makro ponownie i wybrać "dograj do istniejącego").
    2a. **JEDYNA decyzja, która świadomie ZOSTAŁA lokalna** — dla dogrywanego elementu ze
        statusem "wydany" (w tym statusie PDM nie pozwala dogrywać plików — sprawdzane też
        po stronie serwera): makro pyta, czy stworzyć nową rewizję (bezpośrednio przed
        faktycznym dograniem pliku, więc to bardziej potwierdzenie operacji na dysku niż
        dane elementu w PDM). Odmowa → nic nie jest zapisywane. Zgoda → status zmienia się
        na "w pracy" (ten sam mechanizm co w aplikacji webowej), co podnosi numer rewizji.
    3. Element w tym momencie już istnieje w PDM (nowy — stworzony przez formularz w
       przeglądarce; już istniejący — wskazany tam samym paskiem, zob. punkt 2). W obu
       przypadkach makro KOPIUJE bieżący plik dokumentu do
       PDM pod nazwą "numer (nazwa).REWIZJA.rozszerzenie"
       — ten sam format numer/nazwa, w jakim PDM wyświetla Części/Złożenia wszędzie indziej
       (zob. itemDisplayLabel w froncie), plus rewizja jako WIELKA LITERA (A, B, C... — ta
       sama konwencja co revisionLabel() we froncie; numer w bazie zostaje liczbą, to czysto
       kwestia formatowania nazwy). LOKALNY dokument jest też zapisywany (Save As) pod TĄ
       SAMĄ nazwą, w tym samym folderze co oryginał — stary plik zostaje na dysku nietknięty,
       ale doc.FileName od teraz wskazuje na nowy. Dzięki temu złożenie linkujące (App::Link)
       do tego dokumentu, zapisywane PO nim w tej samej sesji (a automatycznie wykryte drzewo
       złożenia zawsze zapisuje złożenie jako ostatnie — patrz niżej), zapisze swój odnośnik
       już pod nową nazwą — dokładnie tą, pod jaką EasyPDMDownload.FCMacro później zapisuje
       pobrane pliki, więc odnośniki po pobraniu od razu się zgadzają (bez tego złożenie
       szukałoby oryginalnej, sprzed-wysyłkowej nazwy pliku, potwierdzone w praktyce
       komunikatem FreeCAD "Link broken! ... File: <oryginalna_nazwa>.FCStd"). Jeśli magazyn
       PDM jest widoczny z tej maszyny (zob. GET /api/config), kopia trafia do WSPÓLNEGO
       folderu storage/components/ (jednego dla wszystkich projektów — Część/Złożenie bywa
       współdzielone jako komponent BOM między projektami) i jest REJESTROWANA
       (POST .../attachments/register, bez ponownego przesyłania przez HTTP — kopia już
       fizycznie leży w magazynie serwera). PDM ZACHOWUJE kopie poprzednich rewizji (np.
       "67 (nazwa).A.FCStd" zostaje, gdy powstaje rewizja B) — nadpisywana jest tylko kopia
       TEJ SAMEJ rewizji (powtórna wysyłka bez zmiany statusu). Jeśli magazyn jest
       nieosiągalny, kopia trafia przez zwykły upload HTTP (POST /api/items/{id}/attachments,
       ten sam mechanizm co dogrywanie plików CAD z panelu właściwości w aplikacji webowej).

Automatyczne wykrywanie złożenia:
    Jeśli aktywny dokument linkuje (App::Link — standardowy sposób budowania złożeń
    w workbenchu Assembly/Assembly4) do INNYCH, zapisanych plików .FCStd, makro PRZED
    otwarciem głównego okna pyta, czy wysłać całe drzewo automatycznie — podsumowanie
    pokazuje przy okazji, do którego DOKŁADNIE elementu PDM trafi każdy już rozpoznany
    komponent (numer + nazwa), nie tylko nazwę pliku, żeby dało się zauważyć nieaktualne
    dopasowanie (zob. match_existing_item) PRZED czymkolwiek. Po zgodzie: schodzi
    rekurencyjnie w głąb (pod-złożenia też mogą linkować dalej) i dla KAŻDEGO jeszcze nie
    wysłanego komponentu przechodzi przez TEN SAM formularz w przeglądarce co główny
    dokument (patrz punkt 2 wyżej) — jedna karta na raz, po kolei, NIGDY kilka naraz
    (ochrona Windows przed "kradzieżą focusu" i tak wyciszyłaby każdą kolejną kartę
    otwartą zaraz po poprzedniej bez świeżej interakcji użytkownika — stąd natywny popup
    "kliknij OK" tuż przed każdym otwarciem, żeby to kliknięcie policzyło się jako ta
    świeża interakcja). Każdy komponent dostaje więc WŁASNY, niezależny wybór projektu/
    typu/nazwy/rodzaju/eksportu STEP i PDF — te same reguły co dla głównego dokumentu,
    tylko każdy w osobnym bilecie. Wysyła wszystko w kolejności LIŚCIE NAJPIERW, na końcu
    główny dokument, budując po drodze cały BOM (z ilością odczytaną z liczby odnośników
    do tego samego pliku — pojedyncze linki i wzorce/tablice linków liczą się razem).
    Nowo utworzony w ten sposób komponent znika z korzenia projektu w aplikacji webowej,
    gdy tylko zostanie podpięty pod swojego prawdziwego rodzica — jego utworzenie jest
    czystym efektem ubocznym kolejności liście-najpierw, nigdy nie miał być niezależnym
    elementem. Komponent uznaje za "już wysłany", jeśli jego etykieta pasuje do formatu
    "numer (nazwa).REWIZJA" (ten sam, który makro samo nadaje po wysyłce) I taki numer
    istnieje w PDM — wtedy tylko podpina go do BOM-u, bez tworzenia duplikatu i bez
    otwierania dla niego przeglądarki. "Nie" na pytanie o wysłanie drzewa wysyła TYLKO
    bieżący dokument, dokładnie jak dotychczas (bez podelementów).

Logowanie:
    EasyPDM.Api wymaga sesji (ciasteczko pdm_session) dla każdego wywołania poza
    POST /api/auth/login — to samo makro więc też się loguje. Przy pierwszym uruchomieniu
    (albo gdy zapisana sesja wygasła/została unieważniona) pojawia się okno logowania
    (nazwa użytkownika + hasło); token sesji trafia do tych samych preferencji FreeCAD co
    adres API (User parameter:BaseApp/EasyPDM), więc kolejne uruchomienia makra (także po
    restarcie FreeCAD) NIE proszą o ponowne logowanie, dopóki sesja jest ważna (30 dni, tak
    samo jak w aplikacji webowej). W oknie "Folder docelowy" (pierwsze okno w każdym
    przebiegu, zob. punkt 1a) widać, kto jest zalogowany, i można się stamtąd wylogować
    (przycisk "Wyloguj") — kolejne uruchomienie makra od razu poprosi o ponowne zalogowanie.
    Ta sama sesja makra jest NIEZBĘDNA nawet dla kroku 2 (cała decyzja nowy/istniejący i
    wszystko z nią związane dzieje się w przeglądarce) — makro samo musi się cały czas
    potrafić uwierzytelnić, żeby (a) odpytać, czy przeglądarka już skończyła (GET
    /create-tickets), i (b) dograć sam plik CAD do wskazanego elementu (to wciąż robi
    makro, nie przeglądarka — nie ma jak temu zapobiec bez utraty automatyzacji zmiany
    nazwy pliku/eksportu STEP/BOM złożenia). Przy okazji: to WŁAŚNIE ta sesja makra jest
    tym, co loguje przeglądarkę
    automatycznie — GET /api/auth/browser-login zamienia token makra na ciasteczko
    przeglądarki (zob. AuthEndpoints.cs), więc logowanie w makrze i "darmowe" zalogowanie
    przeglądarki to JEDNA, ta sama operacja, nie dwie osobne.

Ograniczenia (świadomie poza zakresem pierwszej wersji):
    - Krok 2 (punkt wyżej) wymaga, żeby domyślna przeglądarka systemowa umiała otworzyć
      adres serwera PDM (ten sam, co adres API w preferencjach makra) — na typowej
      instalacji (klient i serwer w tej samej sieci) działa to bez dodatkowej konfiguracji.
      Okno oczekiwania w FreeCAD ma limit 10 minut — po przekroczeniu (albo Anuluj) makro
      kończy się komunikatem, bez dogrania pliku; jeśli element zdążył już powstać w
      przeglądarce, trzeba uruchomić makro ponownie i dograć do niego przez pasek
      "oczekujące żądanie z makra".
    - Automatyczne wykrywanie złożenia działa tylko dla odnośników do ZEWNĘTRZNYCH,
      zapisanych plików (App::Link) — nie dla złożeń trzymanych w jednym pliku jako
      kontenery App::Part (te nie mają osobnych plików do wysłania osobno).
    - Rozpoznanie "już wysłanego" komponentu opiera się na etykiecie dokumentu — makro
      samo ją nadaje po wysłaniu i od razu zapisuje (Save As pod nazwą PDM), więc w
      odróżnieniu od wcześniejszej wersji działa też w NOWEJ sesji FreeCAD, o ile otwarty
      zostanie ten (przemianowany) plik, nie stara kopia sprzed wysyłki.
    - Lokalny plik dokumentu jest teraz PRZENOSZONY na nową nazwę (Save As) przy każdej
      wysyłce — stary plik (pod oryginalną nazwą) zostaje na dysku, ale nie jest już
      aktywnie edytowany/otwarty; jeśli ktoś ręcznie wróci do starego pliku i coś w nim
      zmieni, te zmiany NIE trafią automatycznie do PDM (trzeba by je wysłać z powrotem,
      tworząc kolejną rewizję).
    - Kopiowanie/rejestrowanie pliku w folderze magazynu zakłada, że jest on widoczny
      w systemie plików tej maszyny (dziś: klient i serwer na tym samym dysku) — jeśli
      GET /api/config jest nieosiągalne albo ścieżka nie istnieje/nie da się do niej
      zapisać, kopia trafia do PDM zwykłym uploadem (kopia HTTP) — w tym trybie
      fallbackowym historia rewizji nie jest zachowywana (każda wysyłka nadpisuje
      poprzednią kopię po stronie PDM).
    - Adres API zapisywany jest w preferencjach FreeCAD (User parameter:BaseApp/EasyPDM),
      domyślnie http://localhost:5000/api.
"""

import json
import os
import re
import shutil
import tempfile
import uuid
import webbrowser
from urllib import error, request
from urllib.parse import urlencode

import FreeCAD as App

try:
    from PySide6 import QtCore, QtWidgets
except ImportError:
    try:
        from PySide2 import QtCore, QtWidgets
    except ImportError:
        from PySide import QtCore
        from PySide import QtGui as QtWidgets  # bardzo stare FreeCAD (Qt4)


def _match_lang(raw):
    raw = (raw or "").strip().lower()
    if not raw:
        return None
    if raw.startswith("pl") or "polish" in raw or "polski" in raw:
        return "pl"
    if raw.startswith("de") or "german" in raw or "deutsch" in raw:
        return "de"
    if raw.startswith("en") or "english" in raw:
        return "en"
    return None


def _detect_language():
    """Auto-wykrycie języka: najpierw własne ustawienie FreeCAD (Preferences -> General ->
    Language) — bywa zapisane jako nazwa ("Polish"/"German") albo jako kod locale
    ("pl"/"pl_PL"/"de_DE" — stąd dopasowanie i po nazwie, i po prefiksie kodu), a jeśli to
    niejednoznaczne (pusty string albo coś spoza pl/en/de), sprawdzamy locale systemu
    operacyjnego ($LANGUAGE/$LC_ALL/$LANG — na Linuksie zwykle "pl_PL.UTF-8"). Fallback na
    angielski, jeśli nic nie pasuje albo odczyt się nie powiedzie."""
    try:
        raw = App.ParamGet("User parameter:BaseApp/Preferences/General").GetString("Language", "")
    except Exception:
        raw = ""
    lang = _match_lang(raw)
    if lang:
        return lang
    raw_os = os.environ.get("LANGUAGE") or os.environ.get("LC_ALL") or os.environ.get("LANG") or ""
    return _match_lang(raw_os) or "en"


LANG = _detect_language()


