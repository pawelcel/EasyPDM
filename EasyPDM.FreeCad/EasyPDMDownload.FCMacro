# -*- coding: utf-8 -*-
"""
EasyPDMDownload — makro FreeCAD do OTWIERANIA Części/Złożeń z EasyPDM (pobiera z serwera
i od razu otwiera w FreeCAD).

Instalacja / uruchomienie: dokładnie jak EasyPDMUpload.FCMacro — Macro -> Macros... ->
"Add path to macro path list", albo "Execute macro from file" bezpośrednio na tym pliku.
Logowanie i adres API są WSPÓLNE z EasyPDMUpload.FCMacro (te same preferencje FreeCAD,
User parameter:BaseApp/EasyPDM) — zalogowanie się w jednym makrze starcza dla obu.

Co robi:
    1. Okno z wyszukiwarką Części/Złożenia (jak przy wysyłaniu — pole z podpowiedziami
       po numerze/nazwie, przeszukujące CAŁĄ bazę) i folderem docelowym. Folder domyślnie
       podpowiada ostatnio użyty (zapamiętany w preferencjach FreeCAD), z przyciskiem "..."
       do zmiany.
    2. Dla Złożenia: pobiera też WSZYSTKIE jego składniki rekurencyjnie (bezpośrednie dzieci,
       potem ich dzieci, i tak dalej — cały BOM), do TEGO SAMEGO folderu co plik główny.
       Bez tego złożenie zbudowane na odnośnikach App::Link do zewnętrznych, zapisanych
       plików (standard w workbenchu Assembly/Assembly4) nie miałoby czym się otworzyć —
       FreeCAD rozwiązuje te odnośniki dopiero przy otwieraniu dokumentu, więc pliki
       składników muszą już leżeć na dysku PRZED otwarciem pliku głównego.
    3. Dla każdego pliku: jeśli w folderze docelowym jest już plik o DOKŁADNIE tej samej
       nazwie (czyli tej samej rewizji) i tym samym rozmiarze co na serwerze — pomija
       (nie pobiera drugi raz).
    4. Jeśli w folderze jest już plik tego samego elementu, ale w INNEJ (starszej) rewizji,
       a na serwerze jest nowsza — pyta, czy pobrać nowszą, zamiast cicho nadpisywać albo
       cicho zostawiać nieaktualny plik.
    5. Na końcu otwiera główny (wybrany) plik w FreeCAD (App.openDocument) — pliki składników
       zostają tylko na dysku, nie są automatycznie otwierane jako osobne dokumenty (dokładnie
       tak, jak FreeCAD sam otwiera złożenie: linkowane pliki wczytuje w tle, bez oddzielnych
       okien).

Skąd bierze pliki do pobrania:
    EasyPDM przechowuje AKTUALNY plik CAD Części/Złożenia jako załącznik (nie ma osobnego
    mechanizmu "plik elementu") — a przy KAŻDEJ wysyłce nowej rewizji poprzednia kopia
    ZOSTAJE (nowy załącznik obok starego, różne nazwy: "numer (nazwa).REWIZJA.rozszerzenie",
    ta sama konwencja co EasyPDMUpload.FCMacro), więc historia rewizji jest w praktyce
    odtwarzalna z listy załączników. To makro rozpoznaje tę konwencję, żeby trafić w
    załącznik odpowiadający AKTUALNEJ rewizji elementu (item["revisionNumber"]) — jeśli
    element nigdy nie przeszedł przez żadne makro CAD (np. dograny ręcznie w aplikacji
    webowej, więc załączniki mają dowolne, oryginalne nazwy), bierze po prostu najnowiej
    wgrany załącznik jako najlepsze przybliżenie.

Ograniczenia (świadomie poza zakresem pierwszej wersji):
    - Nie próbuje pobierać KONKRETNEJ starszej rewizji — zawsze celuje w aktualną, a starsze
      lokalne kopie służą tylko do wykrycia "masz nieaktualną wersję" (patrz punkt 4).
    - Wszystkie pliki (główny + składniki) lądują płasko w JEDNYM folderze, bez odtwarzania
      struktury BOM jako podfolderów — to najbezpieczniejszy wybór dla odnośników App::Link
      zapisanych jako ścieżki WZGLĘDEM folderu dokumentu (typowe dla Assembly4), ale jeśli
      oryginalny model był budowany z plikami w osobnych podfolderach, odnośniki mogą mimo
      to nie rozwiązać się automatycznie — wtedy trzeba je poprawić ręcznie w FreeCAD
      (Assembly4 ma do tego narzędzie "Make link relative"/zmianę ścieżki).
    - Współdzielony komponent (użyty w kilku miejscach drzewa) pobierany jest tylko raz
      (rozpoznawany po ID elementu), tak samo jak w EasyPDMUpload.FCMacro.
"""

import json
import os
import re
from urllib import error, request

import FreeCAD as App

try:
    from PySide6 import QtCore, QtWidgets
except ImportError:
    try:
        from PySide2 import QtCore, QtWidgets
    except ImportError:
        from PySide import QtCore
        from PySide import QtGui as QtWidgets  # bardzo stare FreeCAD (Qt4)


# Ta sama grupa preferencji co EasyPDMUpload.FCMacro — adres API i sesja logowania są
# współdzielone między oboma makrami (zalogowanie się w jednym starcza dla drugiego).
PARAM_GROUP = "User parameter:BaseApp/EasyPDM"
DEFAULT_BASE_URL = "http://localhost:5000/api"
SESSION_COOKIE_NAME = "pdm_session"


class AuthError(RuntimeError):
    """Brak sesji albo sesja wygasła/została unieważniona."""
    pass


def get_base_url():
    return App.ParamGet(PARAM_GROUP).GetString("ApiBaseUrl", DEFAULT_BASE_URL).rstrip("/")


def set_base_url(url):
    App.ParamGet(PARAM_GROUP).SetString("ApiBaseUrl", url.rstrip("/"))


def get_session_token():
    token = App.ParamGet(PARAM_GROUP).GetString("SessionToken", "")
    return token or None


def set_session_token(token):
    App.ParamGet(PARAM_GROUP).SetString("SessionToken", token or "")


def get_saved_username():
    name = App.ParamGet(PARAM_GROUP).GetString("SavedDisplayName", "")
    return name or None


def set_saved_username(name):
    App.ParamGet(PARAM_GROUP).SetString("SavedDisplayName", name or "")


def get_download_folder():
    """Ostatnio użyty folder pobierania — osobna preferencja (nie dotyczy wysyłania),
    ale w tej samej grupie co reszta ustawień EasyPDM."""
    folder = App.ParamGet(PARAM_GROUP).GetString("DownloadFolder", "")
    return folder or None


def set_download_folder(folder):
    App.ParamGet(PARAM_GROUP).SetString("DownloadFolder", folder or "")


def _auth_headers():
    token = get_session_token()
    return {"Cookie": f"{SESSION_COOKIE_NAME}={token}"} if token else {}


def _read_error_body(http_error):
    try:
        return http_error.read().decode("utf-8") or str(http_error)
    except Exception:
        return str(http_error)


def _raise_for_http_error(e):
    if e.code == 401:
        raise AuthError(_read_error_body(e))
    raise RuntimeError(_read_error_body(e))


def api_get(path):
    req = request.Request(get_base_url() + path, method="GET", headers=_auth_headers())
    try:
        with request.urlopen(req, timeout=15) as resp:
            body = resp.read().decode("utf-8")
            return json.loads(body) if body else None
    except error.HTTPError as e:
        _raise_for_http_error(e)
    except error.URLError as e:
        raise RuntimeError(f"Brak połączenia z {get_base_url()}: {e.reason}")


def api_get_binary(path):
    """Jak api_get, ale zwraca surowe bajty odpowiedzi — do pobierania zawartości plików
    (załączników), które nie są JSON-em."""
    req = request.Request(get_base_url() + path, method="GET", headers=_auth_headers())
    try:
        with request.urlopen(req, timeout=120) as resp:
            return resp.read()
    except error.HTTPError as e:
        _raise_for_http_error(e)
    except error.URLError as e:
        raise RuntimeError(f"Brak połączenia z {get_base_url()}: {e.reason}")


def api_login(username, password):
    data = json.dumps({"username": username, "password": password}).encode("utf-8")
    req = request.Request(
        get_base_url() + "/auth/login", data=data, method="POST",
        headers={"Content-Type": "application/json"},
    )
    try:
        with request.urlopen(req, timeout=10) as resp:
            body = resp.read().decode("utf-8")
            user = json.loads(body) if body else {}
            set_cookie_header = resp.headers.get("Set-Cookie", "")
    except error.HTTPError as e:
        raise RuntimeError(_read_error_body(e))
    except error.URLError as e:
        raise RuntimeError(f"Brak połączenia z {get_base_url()}: {e.reason}")

    token = None
    for part in set_cookie_header.split(";"):
        part = part.strip()
        if part.startswith(f"{SESSION_COOKIE_NAME}="):
            token = part[len(SESSION_COOKIE_NAME) + 1:]
            break
    if not token:
        raise RuntimeError("Logowanie nie powiodło się — serwer nie zwrócił sesji.")

    set_session_token(token)
    set_saved_username(user.get("displayName") or user.get("username") or username)
    return user


def api_logout():
    token = get_session_token()
    if token:
        req = request.Request(
            get_base_url() + "/auth/logout", method="POST", headers=_auth_headers()
        )
        try:
            request.urlopen(req, timeout=10)
        except Exception:
            pass
    set_session_token(None)
    set_saved_username(None)


def ensure_logged_in():
    if get_session_token():
        try:
            me = api_get("/auth/me")
            # Odświeżamy zapisaną nazwę z /auth/me — bez tego, jeśli token pochodzi z sesji
            # zapisanej wcześniej BEZ przechodzenia przez api_login() w tej instalacji,
            # SavedDisplayName zostawałoby puste na zawsze mimo ważnej sesji — okno
            # pokazywałoby "Zalogowano jako: ?" (dokładnie tak, jak zaobserwowano w praktyce).
            if me:
                set_saved_username(me.get("displayName") or me.get("username"))
            return True
        except AuthError:
            set_session_token(None)
        except Exception:
            return True

    dlg = LoginDialog()
    return dlg.exec() == QtWidgets.QDialog.Accepted


def sanitize_filename(name):
    cleaned = re.sub(r'[\\/:*?"<>|]+', "_", name).strip()
    return cleaned or "bez_nazwy"


def revision_label(n):
    """Rewizje jako wielkie litery: 1->A, 2->B, ..., 26->Z, 27->AA... — ta sama konwersja
    co w EasyPDMUpload.FCMacro/api/types.ts (revisionLabel)."""
    n = int(n)
    label = ""
    while n > 0:
        n, remainder = divmod(n - 1, 26)
        label = chr(65 + remainder) + label
    return label or "A"


def _revision_attachment_pattern(item_number, name):
    """Regex dopasowujący własną konwencję nazewnictwa makr PDM: "numer (nazwa).REWIZJA."
    — grupa 1 to litera rewizji. Ta sama nazwa co nada EasyPDMUpload.FCMacro (zob. tam
    _rename_and_upload) — dzięki temu pobieranie i wysyłanie zawsze się zgadzają."""
    return re.compile(
        rf"^{item_number}\s*\({re.escape(sanitize_filename(name))}\)\.([A-Za-z]+)\.",
        re.IGNORECASE,
    )


def _find_current_attachment(item, attachments):
    """Wybiera załącznik odpowiadający AKTUALNEJ rewizji elementu. Jeśli żaden załącznik
    nie pasuje do konwencji nazw makr PDM (np. element dograny ręcznie w aplikacji webowej),
    bierze po prostu najnowiej wgrany załącznik (lista jest posortowana rosnąco po dacie)
    jako najlepsze przybliżenie."""
    if not attachments:
        return None
    number = item.get("itemNumber")
    name = item.get("fileName", "")
    if number is not None:
        pattern = _revision_attachment_pattern(number, name)
        matches = []
        for a in attachments:
            m = pattern.match(a["fileName"])
            if m:
                matches.append((m.group(1), a))
        if matches:
            wanted = revision_label(item["revisionNumber"]).upper() if item.get("revisionNumber") else None
            for label, a in matches:
                if wanted and label.upper() == wanted:
                    return a
            return matches[-1][1]
    return attachments[-1]


def _local_revision_files(target_dir, item_number, name):
    """Lokalne pliki w target_dir pasujące do konwencji nazw TEGO elementu (dowolna
    rewizja) — do wykrycia "mam już starszą rewizję" (patrz _download_item)."""
    if item_number is None:
        return []
    pattern = _revision_attachment_pattern(item_number, name)
    result = []
    try:
        for fname in os.listdir(target_dir):
            m = pattern.match(fname)
            if m:
                result.append((m.group(1), os.path.join(target_dir, fname)))
    except OSError:
        pass
    return result


def _download_item(item, target_dir, log):
    """Pobiera aktualny plik CAD Części/Złożenia `item` do target_dir (patrz reguły 3 i 4
    w docstringu modułu). Zwraca ścieżkę do pliku, który finalnie jest/zostaje w folderze
    (świeżo pobrany, już tam był, albo — gdy użytkownik odmówił pobrania nowszej rewizji —
    ta stara, którą i tak ma), albo None, jeśli nic nie udało się ustalić."""
    number = item.get("itemNumber")
    name = item.get("fileName", "")
    label = f"{number} ({name})"

    try:
        attachments = api_get(f"/items/{item['id']}/attachments") or []
    except Exception as e:
        log(f"  {label}: nie udało się pobrać listy załączników ({e}).")
        return None

    current = _find_current_attachment(item, attachments)
    if current is None:
        log(f"  {label}: brak plików CAD do pobrania (element nie ma żadnych załączników).")
        return None

    target_path = os.path.join(target_dir, current["fileName"])

    if os.path.exists(target_path):
        try:
            same_size = os.path.getsize(target_path) == current.get("fileSize")
        except OSError:
            same_size = False
        if same_size:
            log(f"  {label}: już jest w folderze (aktualna rewizja), pomijam.")
            return target_path

    older = [
        (rev, path)
        for rev, path in _local_revision_files(target_dir, number, name)
        if path != target_path
    ]
    if older:
        rev_list = ", ".join(sorted({rev for rev, _ in older}))
        wanted = revision_label(item["revisionNumber"]) if item.get("revisionNumber") else "?"
        answer = QtWidgets.QMessageBox.question(
            None,
            "Nowsza rewizja",
            f"W folderze jest już {label} w rewizji {rev_list}, a na serwerze aktualna "
            f"jest rewizja {wanted}.\n\nPobrać najnowszą wersję?",
            QtWidgets.QMessageBox.Yes | QtWidgets.QMessageBox.No,
        )
        if answer != QtWidgets.QMessageBox.Yes:
            log(f"  {label}: zostawiam istniejącą lokalną rewizję ({rev_list}).")
            return older[0][1] if len(older) == 1 else None

    log(f"  Pobieram {current['fileName']}...")
    try:
        content = api_get_binary(f"/attachments/{current['id']}/file")
    except Exception as e:
        log(f"  {label}: BŁĄD pobierania {current['fileName']} ({e}).")
        return None

    os.makedirs(target_dir, exist_ok=True)
    with open(target_path, "wb") as f:
        f.write(content)
    log(f"  Zapisano: {current['fileName']}")
    return target_path


def _download_children_recursive(item, target_dir, log, seen):
    """Rekurencyjnie pobiera CAŁE drzewo składników Złożenia (bezpośrednie dzieci, potem
    ich dzieci, itd.) do target_dir — patrz punkt 2 w docstringu modułu. `seen` (zbiór ID
    elementów) chroni przed podwójnym pobraniem tego samego, współdzielonego komponentu."""
    try:
        rows = api_get(f"/items/{item['id']}/children") or []
    except Exception as e:
        label = f"{item.get('itemNumber')} ({item.get('fileName')})"
        log(f"  {label}: nie udało się pobrać listy składników ({e}).")
        return
    # UWAGA: odpowiedź to lista {"item": {...}, "quantity": ..., "position": ...} — sam
    # element jest ZAGNIEŻDŻONY pod kluczem "item" (ta sama konwencja co childEntries
    # w item-detail-panel.tsx), NIE płaski obiekt jak w GET /api/items.
    for row in rows:
        child = row["item"]
        if child["id"] in seen:
            continue
        seen.add(child["id"])
        _download_item(child, target_dir, log)
        if child["itemType"] == "assembly":
            _download_children_recursive(child, target_dir, log, seen)


class LoginDialog(QtWidgets.QDialog):
    """Identyczne okno logowania co w EasyPDMUpload.FCMacro (współdzielona sesja, ale
    dwa osobne pliki makr — FreeCAD nie ma niezawodnego sposobu importowania jednego
    makra z drugiego, więc kod jest świadomie zduplikowany, nie importowany)."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Logowanie do PDM")
        self.setMinimumWidth(360)

        layout = QtWidgets.QVBoxLayout(self)
        form = QtWidgets.QFormLayout()
        layout.addLayout(form)

        self.server_edit = QtWidgets.QLineEdit(get_base_url())
        form.addRow("Adres API:", self.server_edit)

        self.username_edit = QtWidgets.QLineEdit()
        form.addRow("Nazwa użytkownika:", self.username_edit)

        self.password_edit = QtWidgets.QLineEdit()
        self.password_edit.setEchoMode(QtWidgets.QLineEdit.Password)
        form.addRow("Hasło:", self.password_edit)

        self.error_label = QtWidgets.QLabel("")
        self.error_label.setStyleSheet("color: #c0392b;")
        self.error_label.setWordWrap(True)
        layout.addWidget(self.error_label)

        buttons = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        buttons.button(QtWidgets.QDialogButtonBox.Ok).setText("Zaloguj")
        buttons.button(QtWidgets.QDialogButtonBox.Cancel).setText("Anuluj")
        buttons.accepted.connect(self._try_login)
        buttons.rejected.connect(self.reject)
        layout.addWidget(buttons)

    def _try_login(self):
        self.error_label.setText("")
        set_base_url(self.server_edit.text().strip())
        username = self.username_edit.text().strip()
        password = self.password_edit.text()
        if not username or not password:
            self.error_label.setText("Podaj nazwę użytkownika i hasło.")
            return
        try:
            api_login(username, password)
        except Exception as e:
            self.error_label.setText(str(e))
            return
        self.accept()


class DownloadDialog(QtWidgets.QDialog):
    """Wybór Części/Złożenia do otwarcia (wyszukiwarka jak w EasyPDMUploadDialog przy
    wysyłaniu do istniejącego elementu) i folderu docelowego."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.result_item = None
        self.result_folder = None
        self._items = []

        self.setWindowTitle("Pobierz z PDM")
        self.setMinimumWidth(440)

        outer = QtWidgets.QVBoxLayout(self)
        form = QtWidgets.QFormLayout()
        outer.addLayout(form)

        account_row = QtWidgets.QHBoxLayout()
        self.account_label = QtWidgets.QLabel(f"Zalogowano jako: {get_saved_username() or '?'}")
        account_row.addWidget(self.account_label)
        logout_btn = QtWidgets.QPushButton("Wyloguj")
        logout_btn.clicked.connect(self.on_logout)
        account_row.addWidget(logout_btn)
        account_row.addStretch(1)
        form.addRow("Konto:", account_row)

        self.item_combo = QtWidgets.QComboBox()
        self.item_combo.setEditable(True)
        self.item_combo.setInsertPolicy(QtWidgets.QComboBox.NoInsert)
        self.item_combo.setMinimumContentsLength(30)
        form.addRow("Część/Złożenie:", self.item_combo)
        form.addRow("", QtWidgets.QLabel("Zacznij pisać, żeby wyszukać po numerze albo nazwie."))

        folder_row = QtWidgets.QHBoxLayout()
        self.folder_edit = QtWidgets.QLineEdit(get_download_folder() or "")
        folder_row.addWidget(self.folder_edit)
        browse_btn = QtWidgets.QPushButton("...")
        browse_btn.setMaximumWidth(32)
        browse_btn.clicked.connect(self.on_browse)
        folder_row.addWidget(browse_btn)
        form.addRow("Folder docelowy:", folder_row)

        self.error_label = QtWidgets.QLabel("")
        self.error_label.setStyleSheet("color: #c0392b;")
        self.error_label.setWordWrap(True)
        outer.addWidget(self.error_label)

        buttons = QtWidgets.QDialogButtonBox(
            QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
        )
        buttons.button(QtWidgets.QDialogButtonBox.Ok).setText("Pobierz i otwórz")
        buttons.accepted.connect(self.on_submit)
        buttons.rejected.connect(self.reject)
        outer.addWidget(buttons)

        self.reload_items()

    def on_logout(self):
        api_logout()
        QtWidgets.QMessageBox.information(
            self, "PDM", "Wylogowano. Kolejne uruchomienie makra poprosi o ponowne zalogowanie."
        )
        self.reject()

    def reload_items(self):
        self.error_label.setText("")
        try:
            all_items = api_get("/items")
        except Exception as e:
            self.error_label.setText(f"Nie udało się pobrać listy elementów: {e}")
            all_items = []
        # Tylko Część/Złożenie — to jedyne typy, które mogą być składnikiem BOM-u
        # i jedyne, dla których to makro w ogóle ma co pobierać (patrz AttachmentEndpoints).
        self._items = [it for it in all_items if it["itemType"] in ("part", "assembly")]
        self.item_combo.clear()
        labels = []
        for it in self._items:
            label = f'{it["itemNumber"]} ({it["fileName"]})'
            labels.append(label)
            self.item_combo.addItem(label, it["id"])
        completer = QtWidgets.QCompleter(labels, self.item_combo)
        completer.setCaseSensitivity(QtCore.Qt.CaseInsensitive)
        completer.setFilterMode(QtCore.Qt.MatchContains)
        completer.setCompletionMode(QtWidgets.QCompleter.PopupCompletion)
        completer.activated.connect(self._on_item_picked)
        self.item_combo.setCompleter(completer)
        self.item_combo.setCurrentIndex(-1)
        self.item_combo.clearEditText()

    def _on_item_picked(self, text):
        idx = self.item_combo.findText(text)
        if idx >= 0:
            self.item_combo.setCurrentIndex(idx)

    def on_browse(self):
        start = self.folder_edit.text().strip() or os.path.expanduser("~")
        chosen = QtWidgets.QFileDialog.getExistingDirectory(self, "Wybierz folder pobierania", start)
        if chosen:
            self.folder_edit.setText(chosen)

    def on_submit(self):
        self.error_label.setText("")
        item_id = self.item_combo.currentData()
        if not item_id:
            self.error_label.setText("Wybierz Część albo Złożenie z listy.")
            return
        folder = self.folder_edit.text().strip()
        if not folder:
            self.error_label.setText("Wskaż folder docelowy.")
            return
        try:
            os.makedirs(folder, exist_ok=True)
        except OSError as e:
            self.error_label.setText(f"Nie można użyć tego folderu: {e}")
            return
        set_download_folder(folder)
        self.result_item = next((it for it in self._items if it["id"] == item_id), None)
        self.result_folder = folder
        self.accept()


def _run_download(dlg, log):
    """Faktyczne pobieranie + otwarcie, wydzielone z main() wyłącznie po to, żeby dało się
    je owinąć w jeden szeroki try/except (zob. main()) — błąd, którego nie przewidzieliśmy
    (np. nieoczekiwany kształt odpowiedzi API), ma się skończyć CZYTELNYM komunikatem
    z pełnym tracebackiem, a nie cichym zniknięciem makra bez żadnego okna na końcu
    (dokładnie to przydarzyło się w praktyce, zanim doszło to zabezpieczenie — zob. też
    poprawiony _download_children_recursive, gdzie leżała PIERWOTNA przyczyna)."""
    top_item = dlg.result_item
    target_dir = dlg.result_folder
    log(f"Pobieram {top_item['itemNumber']} ({top_item['fileName']}) do {target_dir}...")

    seen = {top_item["id"]}
    top_path = _download_item(top_item, target_dir, log)
    if top_item["itemType"] == "assembly":
        _download_children_recursive(top_item, target_dir, log, seen)

    if top_path and os.path.exists(top_path):
        try:
            App.openDocument(top_path)
            log(f"Otwarto: {top_path}")
        except Exception as e:
            log(f"Nie udało się otworzyć {top_path} w FreeCAD: {e}")
    else:
        log("Nie udało się ustalić pliku głównego do otwarcia.")


def main():
    if not ensure_logged_in():
        return

    dlg = DownloadDialog()
    if dlg.exec() != QtWidgets.QDialog.Accepted:
        return

    log_lines = []

    def log(msg):
        log_lines.append(msg)
        App.Console.PrintMessage(msg + "\n")

    try:
        _run_download(dlg, log)
    except Exception:
        import traceback

        tb = traceback.format_exc()
        App.Console.PrintError(tb + "\n")
        QtWidgets.QMessageBox.critical(
            None,
            "EasyPDM — błąd",
            "Pobieranie przerwane nieoczekiwanym błędem:\n\n"
            + tb
            + "\n\nDotychczasowy log:\n"
            + "\n".join(log_lines[-15:]),
        )
        return

    QtWidgets.QMessageBox.information(None, "EasyPDM", "\n".join(log_lines[-25:]))


if __name__ == "__main__":
    main()
