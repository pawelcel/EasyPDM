<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdmSystem.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- UseWindowsService() w Program.cs jest bezpieczne na każdej platformie (aktywuje się
         tylko, gdy proces faktycznie działa pod Windows Service Control Manager) — potrzebne
         wyłącznie dla instalatora Windows (zob. packaging/windows/), nie zmienia niczego przy
         zwykłym "dotnet run"/systemd/Dockerze. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

</Project>
