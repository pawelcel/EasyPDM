<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EasyPDM.Api</RootNamespace>
    <!-- Ikona EasyPDM.Api.exe (skrót na pulpicie/w menu Start z instalatora, pasek zadań).
         Musi leżeć WEWNĄTRZ EasyPDM.Api/ (nie np. w packaging/windows/) — Dockerfile
         kopiuje do kontekstu budowy tylko EasyPDM.Api/ i db/, więc ścieżka wychodząca poza
         ten katalog nie istniałaby wewnątrz kontenera i wywaliłaby "dotnet publish".
         MSBuild osadza ikonę w pliku wykonywalnym tylko przy budowaniu na Windows (resource
         compiler), więc na Linuksie/w Dockerze ten wpis jest nieszkodliwie ignorowany. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- UseWindowsService() w Program.cs jest bezpieczne na każdej platformie (aktywuje się
         tylko, gdy proces faktycznie działa pod Windows Service Control Manager) — potrzebne
         wyłącznie dla instalatora Windows (zob. packaging/windows/), nie zmienia niczego przy
         zwykłym "dotnet run"/systemd/Dockerze. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <!-- Stamps "approved by" into the drawing PDF on release (DrawingStamp.cs). MIT. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp pulls in Pkcs 8.0.1 (CVE-2026-84008); pinned to a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

  <!-- Migracje wbudowane w sam plik wykonywalny (embedded resource) — działa identycznie
       niezależnie od sposobu wdrożenia (Docker, self-contained publish na Linux/Windows,
       zwykłe "dotnet run"), bez zależności od tego, czy folder db/migrations/ został
       skądś skopiowany obok. Zob. MigrationRunner.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\db\migrations\*.sql" LinkBase="Migrations" />
    <!-- osifont (GPL/LGPL with the font exception, see Fonts/osifont.license): the lettering of the
         EasyPDM drawing sheets, embedded in the "approved by" stamp (DrawingStamp.cs). -->
    <EmbeddedResource Include="Fonts\osifont-lgpl3fe.ttf" LogicalName="EasyPDM.Api.Fonts.osifont.ttf" />
  </ItemGroup>

</Project>
