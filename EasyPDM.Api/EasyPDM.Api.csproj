<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EasyPDM.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <!-- UseWindowsService() w Program.cs jest bezpieczne na każdej platformie (aktywuje się
         tylko, gdy proces faktycznie działa pod Windows Service Control Manager) — potrzebne
         wyłącznie dla instalatora Windows (zob. packaging/windows/), nie zmienia niczego przy
         zwykłym "dotnet run"/systemd/Dockerze. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <!-- Migracje wbudowane w sam plik wykonywalny (embedded resource) — działa identycznie
       niezależnie od sposobu wdrożenia (Docker, self-contained publish na Linux/Windows,
       zwykłe "dotnet run"), bez zależności od tego, czy folder db/migrations/ został
       skądś skopiowany obok. Zob. MigrationRunner.cs. -->
  <ItemGroup>
    <EmbeddedResource Include="..\db\migrations\*.sql" LinkBase="Migrations" />
  </ItemGroup>

</Project>
